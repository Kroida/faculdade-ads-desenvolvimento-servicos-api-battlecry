{
  "openapi": "3.0.3",
  "info": {
    "title": "BattleCry API",
    "version": "1.0.0",
    "description": "API REST para uma loja online, com gerenciamento de clientes, produtos, pedidos e autenticação via JWT."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Autenticação",
      "description": "Login e geração de token JWT"
    },
    {
      "name": "Clientes",
      "description": "Cadastro e consulta de clientes"
    },
    {
      "name": "Produtos",
      "description": "Consulta e gerenciamento de produtos"
    },
    {
      "name": "Pedidos",
      "description": "Criação e consulta de pedidos"
    },
    {
      "name": "Categorias",
      "description": "Consulta e cadastro de categorias"
    },
    {
      "name": "Cidades",
      "description": "Consulta e cadastro de cidades"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string",
            "example": "Mensagem de erro"
          }
        }
      },
      "Cidade": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "Porto Alegre"
          }
        }
      },
      "Categoria": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "Armas"
          }
        }
      },
      "ClienteCreate": {
        "type": "object",
        "required": [
          "nome",
          "cidade_id",
          "email",
          "senha"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Luis"
          },
          "altura": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "example": 1.75
          },
          "nascimento": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2000-01-01T00:00:00.000Z"
          },
          "cidade_id": {
            "type": "integer",
            "example": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "luis@email.com"
          },
          "senha": {
            "type": "string",
            "minLength": 6,
            "example": "123456"
          }
        }
      },
      "Cliente": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "Luis"
          },
          "altura": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "example": 1.75
          },
          "nascimento": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2000-01-01T00:00:00.000Z"
          },
          "cidade_id": {
            "type": "integer",
            "nullable": true,
            "example": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "luis@email.com"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "CLIENTE",
              "ADMIN"
            ],
            "example": "CLIENTE"
          },
          "cidades": {
            "$ref": "#/components/schemas/Cidade"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "adm@battlecry.com"
          },
          "senha": {
            "type": "string",
            "example": "1234"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "ProdutoInput": {
        "type": "object",
        "required": [
          "nome",
          "preco",
          "quantidade",
          "categorias_id"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Espada Longa"
          },
          "preco": {
            "type": "number",
            "format": "double",
            "example": 149.9
          },
          "quantidade": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "example": 10
          },
          "categorias_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "Produto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "Espada Longa"
          },
          "preco": {
            "type": "number",
            "format": "double",
            "example": 149.9
          },
          "quantidade": {
            "type": "number",
            "format": "double",
            "example": 10
          },
          "categorias_id": {
            "type": "integer",
            "example": 1
          },
          "categorias": {
            "$ref": "#/components/schemas/Categoria"
          }
        }
      },
      "PedidoItemInput": {
        "type": "object",
        "required": [
          "produto_id",
          "quantidade"
        ],
        "properties": {
          "produto_id": {
            "type": "integer",
            "example": 1
          },
          "quantidade": {
            "type": "number",
            "format": "double",
            "minimum": 1e-06,
            "example": 2
          }
        }
      },
      "PedidoCreate": {
        "type": "object",
        "required": [
          "endereco",
          "produtos"
        ],
        "properties": {
          "endereco": {
            "type": "string",
            "example": "Rua dos Hunters, 150"
          },
          "produtos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/PedidoItemInput"
            }
          }
        }
      },
      "PedidoProduto": {
        "type": "object",
        "properties": {
          "pedido_id": {
            "type": "integer",
            "example": 1
          },
          "produto_id": {
            "type": "integer",
            "example": 1
          },
          "preco": {
            "type": "number",
            "format": "double",
            "example": 149.9
          },
          "quantidade": {
            "type": "number",
            "format": "double",
            "example": 2
          },
          "produtos": {
            "$ref": "#/components/schemas/Produto"
          }
        }
      },
      "Pedido": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "horario": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-02T22:30:00.000Z"
          },
          "endereco": {
            "type": "string",
            "example": "Rua dos Hunters, 150"
          },
          "cliente_id": {
            "type": "integer",
            "example": 1
          },
          "pedidos_produtos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PedidoProduto"
            }
          }
        }
      },
      "NomeUpdate": {
        "type": "object",
        "required": [
          "nome"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Novo nome"
          }
        }
      },
      "ClienteUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "nome": {
            "type": "string",
            "example": "Luis Atualizado"
          },
          "altura": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "example": 1.76
          },
          "nascimento": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2000-01-01T00:00:00.000Z"
          },
          "cidade_id": {
            "type": "integer",
            "nullable": true,
            "example": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "luis.novo@email.com"
          },
          "senha": {
            "type": "string",
            "minLength": 6,
            "example": "nova123"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "CLIENTE",
              "ADMIN"
            ],
            "example": "CLIENTE"
          }
        }
      },
      "PedidoUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "endereco": {
            "type": "string",
            "example": "Rua Atualizada, 200"
          },
          "cliente_id": {
            "type": "integer",
            "example": 2
          },
          "produtos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/PedidoItemInput"
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Requisição inválida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "erro": "Dados inválidos"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Não autenticado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "erro": "Token não informado"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Sem permissão para acessar o recurso",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "erro": "Acesso permitido somente para administradores"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso não encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "erro": "Recurso não encontrado"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Erro interno do servidor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "erro": "Erro interno do servidor"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Realizar login",
        "description": "Autentica um cliente ou administrador e retorna um token JWT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/clientes": {
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Cadastrar cliente",
        "description": "Cria um novo cliente. O tipo é definido automaticamente como CLIENTE e a senha é salva como hash.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Listar clientes",
        "description": "Lista os clientes cadastrados. Rota administrativa.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de clientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cliente"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/clientes/{id}": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Buscar cliente por ID",
        "description": "Retorna um cliente específico. Rota administrativa.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Cliente encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Clientes"
        ],
        "summary": "Atualizar cliente",
        "description": "Atualiza dados de um cliente. Permitido somente para administradores.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cliente atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Clientes"
        ],
        "summary": "Excluir cliente",
        "description": "Exclui um cliente e seus pedidos em transação, restaurando o estoque. O administrador não pode excluir a própria conta.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "responses": {
          "204": {
            "description": "Cliente excluído com sucesso"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/categorias": {
      "get": {
        "tags": [
          "Categorias"
        ],
        "summary": "Listar categorias",
        "description": "Retorna todas as categorias cadastradas.",
        "responses": {
          "200": {
            "description": "Lista de categorias",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Categoria"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Categorias"
        ],
        "summary": "Cadastrar categoria",
        "description": "Cria uma nova categoria. Permitido somente para administradores.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome"
                ],
                "properties": {
                  "nome": {
                    "type": "string",
                    "example": "Armas"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Categoria criada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Categoria"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/cidades": {
      "get": {
        "tags": [
          "Cidades"
        ],
        "summary": "Listar cidades",
        "description": "Retorna todas as cidades cadastradas.",
        "responses": {
          "200": {
            "description": "Lista de cidades",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cidade"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Cidades"
        ],
        "summary": "Cadastrar cidade",
        "description": "Cria uma nova cidade. Permitido somente para administradores.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome"
                ],
                "properties": {
                  "nome": {
                    "type": "string",
                    "example": "Porto Alegre"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cidade criada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cidade"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/produtos": {
      "get": {
        "tags": [
          "Produtos"
        ],
        "summary": "Listar produtos",
        "description": "Retorna os produtos cadastrados.",
        "responses": {
          "200": {
            "description": "Lista de produtos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Produto"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Produtos"
        ],
        "summary": "Cadastrar produto",
        "description": "Cria um novo produto. Permitido somente para administradores.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProdutoInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produto criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Produto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/produtos/{id}": {
      "get": {
        "tags": [
          "Produtos"
        ],
        "summary": "Buscar produto por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
